// Mcaster1DSPEncoder_Qt.rc — Windows resource script
// Embeds the application icon for Windows Explorer and taskbar.

#include <winres.h>

// Application icon (ID 1 = default app icon shown by Windows)
IDI_APPICON ICON "resources\\Mcaster1DSPEncoder_Qt.ico"

// Version info
VS_VERSION_INFO VERSIONINFO
  FILEVERSION     1,2,0,0
  PRODUCTVERSION  1,2,0,0
  FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
  FILEFLAGS       0
  FILEOS          VOS__WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Mcaster1"
      VALUE "FileDescription",  "Mcaster1 DSP Encoder"
      VALUE "FileVersion",      "1.2.0.0"
      VALUE "InternalName",     "Mcaster1DSPEncoder_Qt"
      VALUE "LegalCopyright",   "Copyright (c) 2026 David St. John"
      VALUE "OriginalFilename", "Mcaster1DSPEncoder_Qt.exe"
      VALUE "ProductName",      "Mcaster1 DSP Encoder"
      VALUE "ProductVersion",   "1.2.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
