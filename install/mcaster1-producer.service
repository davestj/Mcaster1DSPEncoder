# =============================================================================
# Mcaster1 Producer — Heavy Workload Daemon (systemd unit)
# MCaster1 LLC / David St John <davestj@mcaster1.com>
#
# DEV MODE — runs from /var/www/mcaster1.com/Mcaster1DSPEncoder/
#
# Heavy workload daemon: video encoding, multi-track mixdown, forensic FFT,
# thumbnail extraction, noise reduction — all via ffmpeg subprocess.
# HTTP admin on port 8360, HTTPS admin on port 8364.
#
# Install:
#   sudo cp install/mcaster1-producer.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable mcaster1-producer
#   sudo systemctl start mcaster1-producer
#
# Check status:
#   sudo systemctl status mcaster1-producer
#   curl -s http://127.0.0.1:8360/api/v1/producer/health | python3 -m json.tool
# =============================================================================

[Unit]
Description=Mcaster1 Producer — Heavy Workload Daemon v1.8.0-beta.1
Documentation=https://mcaster1.com
After=network-online.target mysql.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=mediacast1
Group=mediacast1

# Binary and config — DEV paths
WorkingDirectory=/var/www/mcaster1.com/Mcaster1DSPEncoder
ExecStart=/var/www/mcaster1.com/Mcaster1DSPEncoder/src/linux/mcaster1-producer \
    --config /var/www/mcaster1.com/Mcaster1DSPEncoder/src/linux/config/mcaster1_producer.yaml

# Graceful stop
TimeoutStopSec=15

# Restart policy
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

# Environment
Environment=HOME=/var/www/mcaster1.com/Mcaster1DSPEncoder

# Resource limits — video encoding can be CPU-heavy
LimitNOFILE=65536
LimitNPROC=4096

# Security hardening
NoNewPrivileges=yes
PrivateTmp=no

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcaster1-producer

[Install]
WantedBy=multi-user.target
